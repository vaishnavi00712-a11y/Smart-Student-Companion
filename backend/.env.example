# Environment Configuration for Smart Student Companion Backend
PORT=8000
HOST=0.0.0.0

# MongoDB Connection String (Local or MongoDB Atlas)
# Example for Local: mongodb://localhost:27017
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=smart_student_db

# Minimum Required Attendance Percentage (Default 75%)
MIN_ATTENDANCE_PERCENTAGE=75

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
